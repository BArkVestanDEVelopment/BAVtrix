#define VS_VERSION_INFO 1

1 ICON "bmatrix.ico"
1 24 "bmatrix.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BArkVestan_Development"
            VALUE "FileDescription", "BAVtrix - Matrix digital rain for the Windows desktop"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "bavtrix"
            VALUE "LegalCopyright", "GPL-2.0-or-later. Based on the idea of ZMatrix by Z. Shaker."
            VALUE "OriginalFilename", "bavtrix.exe"
            VALUE "ProductName", "BAVtrix"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
